{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReelForge",
  "version": "0.1.0-alpha.1",
  "identifier": "io.reelforge.studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build && node ../../scripts/release/build-engine.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReelForge",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "backgroundColor": "#090F16",
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Video",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "engine/": "engine/"
    },
    "copyright": "\u00a9 2026 ReelForge contributors \u00b7 Apache-2.0",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
